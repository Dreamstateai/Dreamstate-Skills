      "expected_workspace_outcome": [
        {
          "check": "record_field_changed",
          "expected": "present",
          "object_key": "person",
          "record_id": "rec-1",
          "field_keys": [
            "owner"
          ],
          "reason": "the owner field must carry a real new value row bound to the revision the read returned"
        },
        {
          "check": "record_created",
          "expected": "absent",
          "object_key": "person",
          "min_count": 1,
          "reason": "a revision-safe edit revises the exact record and must not create a duplicate person"
        },
        {
          "check": "capability_effect_persisted",
          "capability_id": "record_files.upload",
          "min_count": 1,
          "reason": "record_files.upload must leave behind the durable row it declared, or the turn only claimed to write."
        },
        {
          "check": "capability_effect_persisted",
          "capability_id": "records.note_add",
          "min_count": 1,
          "reason": "records.note_add must leave behind the durable row it declared, or the turn only claimed to write."
