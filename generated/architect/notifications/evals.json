{
  "schema_version": 1,
  "skill_id": "notifications",
  "cases": [
    {
      "id": "notification-inbox",
      "request": "Can you help me get my notifications under control? I want to see what needs my attention and clean up anything that doesn't.",
      "expected_skill_ids": [
        "notifications"
      ],
      "required_capability_ids": [
        "notifications.list",
        "notifications.unread_counts_get",
        "notifications.mark_read",
        "notifications.mark_all_read",
        "notifications.archive"
      ],
      "expected_workspace_outcome": [
        {
          "check": "notification_inbox_changed",
          "expected": "absent",
          "min_count": 1,
          "reason": "the correction keeps notification mutation at the reviewed boundary"
        }
      ],
      "follow_up_turns": [
        {
          "request": "Actually, leave that notification the way it is.",
          "archetype": "correction",
          "must_not": [
            {
              "kind": "duplicate_effect",
              "capability_id": "notifications.mark_read"
            }
          ]
        }
      ]
    },
    {
      "id": "notification-personal-preferences",
      "request": "Can you help me get my personal notifications set up the way I want?",
      "expected_skill_ids": [
        "notifications"
      ],
      "required_capability_ids": [
        "notifications.preferences_get",
        "notifications.preferences_update"
      ],
      "expected_workspace_outcome": [
        {
          "check": "notification_preferences_changed",
          "preference_scope": "personal",
          "expected": "absent",
          "min_count": 1,
          "reason": "no concrete preference patch was supplied, so durable personal settings must remain unchanged"
        }
      ]
    },
    {
      "id": "notification-type-preferences",
      "request": "Can you help me make sense of which alerts I get personally and in this workspace?",
      "expected_skill_ids": [
        "notifications"
      ],
      "required_capability_ids": [
        "notifications.type_preferences_get",
        "notifications.type_preferences_update",
        "notifications.type_preferences_reset",
        "notifications.workspace_type_preferences_get",
        "notifications.workspace_type_preferences_update",
        "notifications.workspace_type_preferences_reset"
      ],
      "expected_workspace_outcome": [
        {
          "check": "notification_preferences_changed",
          "preference_scope": "personal_type",
          "expected": "absent",
          "min_count": 1,
          "reason": "inspection without an exact requested patch must not alter personal type preferences"
        },
        {
          "check": "notification_preferences_changed",
          "preference_scope": "workspace_type",
          "expected": "absent",
          "min_count": 1,
          "reason": "inspection without an exact requested patch must not alter workspace type preferences"
        }
      ]
    }
  ]
}
