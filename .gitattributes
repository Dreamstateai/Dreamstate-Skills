# This is a skills library: its substance is the markdown playbooks, not the
# small Node installer. GitHub Linguist classifies Markdown as "prose" and hides
# it from the language bar by default, which made the repo read as 100% JavaScript
# off the four .mjs files alone. Force the skill content to count, and mark the
# generated tree + lockfile as non-primary, so the language bar reflects reality.

*.md      linguist-detectable=true
*.md      linguist-documentation=false

# Generated by `npm run build` from playbooks/ — not hand-authored source.
dist/**            linguist-generated=true
skills/**          linguist-generated=true
skills-index.json  linguist-generated=true

package-lock.json  linguist-generated=true
