# This is a skills library: its substance is the markdown playbooks, and the
# installer/build tooling is TypeScript (src/, scripts/, test/). GitHub Linguist
# classifies Markdown as "prose" and hides it by default, so force the skill
# content to count. Mark the compiled JS output and generated trees as non-primary
# so the language bar reflects reality (TypeScript + Markdown, not JavaScript).

*.md      linguist-detectable=true
*.md      linguist-documentation=false

# Compiled from src/*.ts by `npm run compile` — not hand-authored source.
lib/**             linguist-generated=true

# Generated by `npm run build` from playbooks/ — not hand-authored source.
dist/**            linguist-generated=true
skills/**          linguist-generated=true
skills-index.json  linguist-generated=true

package-lock.json  linguist-generated=true
