{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trydreamstate.com/schemas/skill-manifest-v2.json",
  "title": "Dreamstate Skill Manifest",
  "type": "object",
  "required": ["schema_version", "slug", "name", "short_description", "domain", "category", "execution_mode", "maturity", "supported_clients", "capability_ids", "mcp_tools", "required_scopes", "minimum_api_version", "verified_capability_hash", "github_path", "provenance"],
  "properties": {
    "schema_version": { "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "short_description": { "type": "string", "minLength": 40 },
    "execution_mode": { "enum": ["executable", "guided-execution", "knowledge", "planned"] },
    "maturity": { "enum": ["stable", "beta", "experimental"] },
    "supported_clients": { "type": "array", "items": { "enum": ["claude", "cursor", "codex", "gemini", "opencode"] }, "minItems": 1, "uniqueItems": true },
    "capability_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "mcp_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "required_scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "verified_capability_hash": { "type": "string", "minLength": 8 },
    "github_path": { "type": "string", "pattern": "^skills/.+/SKILL\\.md$" },
    "provenance": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["kind", "note"] } }
  },
  "additionalProperties": true
}
